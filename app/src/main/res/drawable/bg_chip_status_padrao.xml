<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fundo levemente destacado -->
    <solid android:color="@color/fundo_claro" />

    <!-- Borda suave -->
    <stroke
        android:width="1dp"
        android:color="@color/cinza_texto" />

    <!-- Cantos arredondados -->
    <corners android:radius="16dp" />

    <!-- Padding interno (opcional, só pra dar respiro) -->
    <padding
        android:left="8dp"
        android:top="4dp"
        android:right="8dp"
        android:bottom="4dp" />
</shape>
