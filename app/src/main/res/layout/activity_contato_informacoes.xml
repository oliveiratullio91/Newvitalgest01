<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_claro"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Contato e Informações"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/vermelho_primario"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="✉️ Enviar Email"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/vermelho_primario"
        android:textAllCaps="false"
        android:layout_marginBottom="16dp"
        android:padding="12dp" />

    <Button
        android:id="@+id/btnTelefone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📞 Ligar para o suporte"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/vermelho_primario"
        android:textAllCaps="false"
        android:layout_marginBottom="16dp"
        android:padding="12dp" />

    <Button
        android:id="@+id/btnSite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🌐 Acessar o site"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/vermelho_primario"
        android:textAllCaps="false"
        android:padding="12dp"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnVoltar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Voltar"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:backgroundTint="@color/vermelho_primario"
        android:padding="16dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="16dp"
        app:cornerRadius="12dp" />

</LinearLayout>
