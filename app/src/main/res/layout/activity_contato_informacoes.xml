<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_claro">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Contato e Informações"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/vermelho_primario"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- BOTÕES DE CONTATO -->
        <Button
            android:id="@+id/btnEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✉️ Enviar Email"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/vermelho_primario"
            android:textAllCaps="false"
            android:layout_marginBottom="16dp"
            android:padding="12dp" />

        <Button
            android:id="@+id/btnTelefone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📞 Ligar para o suporte"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/vermelho_primario"
            android:textAllCaps="false"
            android:layout_marginBottom="16dp"
            android:padding="12dp" />

        <Button
            android:id="@+id/btnSite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌐 Acessar o site"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/vermelho_primario"
            android:textAllCaps="false"
            android:padding="12dp"
            android:layout_marginBottom="24dp" />

        <!-- DIVISOR -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/darker_gray"
            android:alpha="0.2"
            android:layout_marginBottom="16dp" />

        <!-- SEÇÃO SOBRE O APP -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sobre o app"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Saiba mais sobre o VitalGest, como seus dados são utilizados e acesse os Termos de Uso e a Política de Privacidade."
            android:textSize="14sp"
            android:textColor="@color/cinza_texto"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnSobreApp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ℹ️ Sobre o app, Termos de Uso e Privacidade"
            android:textColor="@color/vermelho_primario"
            android:backgroundTint="@android:color/white"
            android:textAllCaps="false"
            android:padding="12dp"
            android:layout_marginBottom="24dp"
            app:cornerRadius="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/vermelho_primario" />

        <!-- BOTÃO VOLTAR -->
        <Button
            android:id="@+id/btnVoltar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Voltar"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/vermelho_primario"
            android:padding="16dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="16dp"
            app:cornerRadius="12dp" />

    </LinearLayout>
</ScrollView>
