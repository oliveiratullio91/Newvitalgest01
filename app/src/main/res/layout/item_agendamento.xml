<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="16dp"
    app:cardUseCompatPadding="true"
    app:cardElevation="3dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/fundo_claro"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Linha: Hemocentro + Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtHemocentroItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Hemocentro"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/vermelho_primario" />

            <TextView
                android:id="@+id/txtStatusItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="Pendente"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_status_chip_neutro"
                android:textColor="@android:color/black" />
        </LinearLayout>

        <!-- Data / hora -->
        <TextView
            android:id="@+id/txtDataHoraItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="📅 10/10/2025 às 09:00"
            android:textSize="14sp"
            android:textColor="@android:color/black" />

        <!-- Endereço -->
        <TextView
            android:id="@+id/txtEnderecoItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="📍 Endereço completo"
            android:textSize="14sp"
            android:textColor="@android:color/black" />

        <!-- Telefone -->
        <TextView
            android:id="@+id/txtTelefoneItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="☎ (00) 0000-0000"
            android:textSize="14sp"
            android:textColor="@android:color/black" />

        <!-- Linha de ações -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtVerDetalhesItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ver detalhes"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/azul_info"
                android:padding="8dp" />

            <Button
                android:id="@+id/btnCancelarAgendamento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Cancelar"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:backgroundTint="@color/vermelho_primario"
                android:textColor="@android:color/white" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>