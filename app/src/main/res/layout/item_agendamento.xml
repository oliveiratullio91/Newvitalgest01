<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardUseCompatPadding="true"
    app:cardElevation="5dp"
    android:foreground="?attr/selectableItemBackground"
    android:backgroundTint="@color/fundo_branco">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@color/fundo_claro">

        <!-- Linha superior: Hemocentro + Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtHemocentroItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="HEMOPE Recife"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/vermelho_primario" />

            <TextView
                android:id="@+id/txtStatusItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Agendado"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_chip_status_agendado"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <!-- Data e hora -->
        <TextView
            android:id="@+id/txtDataHoraItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📅 00/00/0000 às 00:00"
            android:textSize="14sp"
            android:textColor="@android:color/black"
            android:layout_marginTop="8dp" />

        <!-- Endereço -->
        <TextView
            android:id="@+id/txtEnderecoItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 Endereço do hemocentro"
            android:textSize="13sp"
            android:textColor="@color/black"
            android:layout_marginTop="4dp" />

        <!-- Telefone -->
        <TextView
            android:id="@+id/txtTelefoneItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="☎ Telefone"
            android:textSize="13sp"
            android:textColor="@color/cinza_texto"
            android:layout_marginTop="2dp" />

        <!-- Botão Cancelar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnCancelarAgendamento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancelar"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/vermelho_primario"
                android:paddingHorizontal="14dp"
                android:paddingVertical="5dp"
                android:elevation="2dp"
                android:layout_gravity="end"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>