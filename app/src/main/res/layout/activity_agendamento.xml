<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/fundo_claro">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="20dp"
        tools:context=".view.Agendamento">

        <!-- Título Principal -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Agendamento de Doação"
            android:textSize="25sp"
            android:textColor="@color/vermelho_primario"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginVertical="40dp"
            android:layout_marginHorizontal="20dp"/>

        <!-- Botão Verificar Elegibilidade -->
        <Button
            android:id="@+id/btVerificarElegibilidade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📋 Verificar Minha Elegibilidade"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:backgroundTint="@color/vermelho_primario"
            app:cornerRadius="15dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="20dp"/>

        <!-- Seção Data -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/vermelho_primario"
            app:cardCornerRadius="8dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📅 Data da Doação"
                android:textSize="18sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="12dp"/>
        </androidx.cardview.widget.CardView>

        <DatePicker
            android:id="@+id/datePicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:calendarViewShown="false"
            android:datePickerMode="spinner"
            android:layout_marginHorizontal="20dp"/>

        <!-- Seção Horário -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/vermelho_primario"
            app:cardCornerRadius="8dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⏰ Horário"
                android:textSize="18sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="12dp"/>
        </androidx.cardview.widget.CardView>

        <TimePicker
            android:id="@+id/timePicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:timePickerMode="spinner"
            android:layout_marginHorizontal="20dp"/>

        <!-- Seção Hemocentros -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🏥 Escolha um Hemocentro"
            android:textSize="18sp"
            android:textColor="@color/azul_info"
            android:textStyle="bold"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"/>

        <!-- Container de Hemocentros -->
        <LinearLayout
            android:id="@+id/containerClinicas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="20dp">

            <!-- HEMOPE Recife -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@color/white"
                    android:padding="16dp">

                    <CheckBox
                        android:id="@+id/hemopeCheckbox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/vermelho_primario" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:id="@+id/txtInfoHemope"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="HEMOPE Recife\nRua Joaquim Nabuco, 171 - Graças\n(81) 3416-4800"
                            android:textSize="14sp"
                            android:textColor="@color/azul_info"
                            android:textStyle="bold"
                            android:lineSpacingExtra="4dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Hospital das Clínicas -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@color/white"
                    android:padding="16dp">

                    <CheckBox
                        android:id="@+id/hcCheckbox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/vermelho_primario" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:id="@+id/txtInfoHc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Hospital das Clínicas\nAv. Prof. Moraes Rego, 1235 - Cidade Universitária\n(81) 2126-3600"
                            android:textSize="14sp"
                            android:textColor="@color/azul_info"
                            android:textStyle="bold"
                            android:lineSpacingExtra="4dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- IMIP -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@color/white"
                    android:padding="16dp">

                    <CheckBox
                        android:id="@+id/imipCheckbox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/vermelho_primario" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:id="@+id/txtInfoImip"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="IMIP\nRua dos Coelhos, 300 - Boa Vista\n(81) 2122-4700"
                            android:textSize="14sp"
                            android:textColor="@color/azul_info"
                            android:textStyle="bold"
                            android:lineSpacingExtra="4dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- Botão Confirmar -->
        <Button
            android:id="@+id/btAgendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✅ Confirmar Agendamento"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:backgroundTint="@color/vermelho_primario"
            app:cornerRadius="15dp"
            android:layout_marginHorizontal="40dp"
            android:layout_marginTop="24dp"/>

    </LinearLayout>
</ScrollView>