<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_claro"
    tools:context=".view.HemocentrosProximosActivity">

    <ScrollView
        android:id="@+id/scrollHemocentros"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/layoutPrincipal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Título -->
            <TextView
                android:id="@+id/txtTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hemocentros do Brasil"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:gravity="center"
                android:paddingBottom="16dp" />

            <!-- Card dos filtros -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFiltros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp"
                android:backgroundTint="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <!-- Região -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Região"
                        android:textStyle="bold"
                        android:textColor="@android:color/black" />

                    <Spinner
                        android:id="@+id/spinnerRegiaoFiltro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="6dp" />

                    <!-- UF -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Estado (UF)"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:paddingTop="6dp" />

                    <Spinner
                        android:id="@+id/spinnerUfFiltro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- Cidade -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cidade"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:paddingTop="6dp" />

                    <Spinner
                        android:id="@+id/spinnerCidadeFiltro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Lista de hemocentros -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerHemocentros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <!-- Botão Voltar -->
            <Button
                android:id="@+id/btnVoltar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Voltar"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:layout_marginTop="20dp"
                android:textColor="@color/vermelho_primario"
                android:backgroundTint="@android:color/transparent" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>