<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_claro"
    android:orientation="vertical">

    <!-- HEADER PREMIUM -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Meus Agendamentos"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/vermelho_primario"
            android:gravity="center_horizontal" />

        <TextView
            android:id="@+id/txtSubtitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Acompanhe seus agendamentos ativos, cancelados e históricos."
            android:textSize="13sp"
            android:textColor="@color/cinza_texto"
            android:gravity="center_horizontal"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- ABAS: Ativos / Cancelados / Histórico (estilo tabs) -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleGrupoAgendamentos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:shapeAppearanceOverlay="@style/ShapeFixToggle">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTabAtivos"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Ativos"
            android:textAllCaps="false"
            android:textSize="13sp"
            app:cornerRadius="16dp"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTabCancelados"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Cancelados"
            android:textAllCaps="false"
            android:textSize="13sp"
            app:cornerRadius="16dp"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTabHistorico"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Histórico"
            android:textAllCaps="false"
            android:textSize="13sp"
            app:cornerRadius="16dp"
            app:strokeWidth="1dp" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- DIVISOR PREMIUM -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="#15000000" />

    <!-- EMPTY STATE MELHORADO -->
    <TextView
        android:id="@+id/txtMensagemVazio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nenhum agendamento encontrado aqui ainda."
        android:textSize="14sp"
        android:textColor="@color/azul_info"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:visibility="gone"
        android:drawableTop="@android:drawable/ic_menu_info_details"
        android:drawablePadding="8dp" />

    <!-- LISTA (fica entre header e bottom bar) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerMeusAgendamentos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp" />

    <!-- BOTÃO VOLTAR -->


        <Button
            android:id="@+id/btnVoltar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Voltar"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/vermelho_primario"
            android:padding="16dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="16dp"
            app:cornerRadius="12dp" />


</LinearLayout>