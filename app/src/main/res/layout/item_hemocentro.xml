<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="16dp"
    app:cardUseCompatPadding="true"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp"
        android:background="@color/fundo_claro">

        <!-- Linha: Nome + Badge de Status + Favorito -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtNomeHemocentro"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="HEMOPE Recife"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/txtStatusHemocentro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="ATIVO"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_status_badge" />

            <!-- Ícone de favorito -->
            <ImageView
                android:id="@+id/imgFavoritoHemocentro"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:padding="2dp"
                android:src="@android:drawable/btn_star_big_off"
                android:contentDescription="Favorito" />
        </LinearLayout>

        <!-- Endereço -->
        <TextView
            android:id="@+id/txtEnderecoHemocentro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Rua Joaquim Nabuco, 171"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray" />

        <!-- Cidade / UF -->
        <TextView
            android:id="@+id/txtCidadeUfHemocentro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Recife - PE"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray" />

        <!-- Telefone -->
        <TextView
            android:id="@+id/txtTelefoneHemocentro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="(81) 3182-4600"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray" />

        <!-- Botões de ação -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btnLigarHemocentro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ligar"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:backgroundTint="@android:color/darker_gray"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />

            <Space
                android:layout_width="10dp"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnMapaHemocentro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ver no mapa"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:backgroundTint="@color/vermelho_primario"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
